APP_NAME=Contact Hunter
ENVIRONMENT=development
SECRET_KEY=sostituisci-con-una-stringa-casuale
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-questa-password
AUTH_ENABLED=true

# SQLite funziona subito. In Docker Compose viene usato PostgreSQL.
DATABASE_URL=sqlite:///./data/contact_hunter.db

# Facoltativa: abilita la scoperta automatica dei siti.
BRAVE_SEARCH_API_KEY=
SEARCH_RESULT_LIMIT=60

CRAWLER_USER_AGENT=ContactHunter/0.1 (+https://tuodominio.it/bot; contatto: privacy@tuodominio.it)
CRAWLER_CONTACT_EMAIL=privacy@tuodominio.it
CRAWLER_DELAY_SECONDS=1.2
CRAWLER_TIMEOUT_SECONDS=20
CRAWLER_MAX_PAGES_PER_DOMAIN=6
CRAWLER_MAX_RESPONSE_BYTES=2000000
CRAWLER_CONCURRENCY=4
RESPECT_ROBOTS_TXT=true
PLAYWRIGHT_ENABLED=true
KEEP_PAGE_SNAPSHOTS=false

BLOCKED_DOMAINS=facebook.com,instagram.com,linkedin.com,youtube.com,tiktok.com,x.com,twitter.com
